{
  "schemaVersion": 2,
  "workflowName": "Agentic Planner-Worker-Judge Workflow V2",
  "description": "Domain-agnostic agentic workflow with deterministic context orchestration. Project identity in AGENTS.md; runtime context via .memory/ and context-builder.",
  "standardsDocs": [
    "AGENTS.md",
    ".memory/constraints.md"
  ],
  "entrypointDocs": [
    ".memory/architecture.md",
    "AGENTS.md"
  ],
  "contextBuilder": {
    "entrypoint": ".cursor/context/context-builder.py",
    "intentDetector": ".cursor/context/intent-detector.py",
    "memoryLoader": ".cursor/context/memory-loader.py",
    "patternMatcher": ".cursor/context/pattern-matcher.py",
    "agentMatrix": ".cursor/config/agent-matrix.json",
    "contextBudget": ".cursor/config/context-budget.json",
    "skillsManifestV2": ".cursor/skills/skills-manifest.v2.json",
    "legacySkillLoader": ".cursor/skills/scripts/skill-loader.py"
  },
  "artifactDirs": {
    "plans": "docs/plans",
    "adrs": "docs/adr",
    "reviews": "docs/reviews",
    "patterns": ".cursor/patterns",
    "memory": ".memory",
    "handoffs": ".cursor/context/handoffs"
  },
  "cycle": [
    "classify",
    "intent-detect",
    "context-build",
    "plan",
    "execute",
    "verify",
    "review",
    "loop-or-complete"
  ],
  "protectedChanges": {
    "classifier": ".cursor/config/protected-paths.json",
    "requirePlan": true,
    "requireReview": true,
    "failClosedOnlyWhenProtected": true,
    "stopRetryCap": 2,
    "overrideLog": "docs/reviews/review-overrides.log"
  },
  "workerScopes": {
    "config": ".cursor/config/worker-scopes.json",
    "enforcement": "preToolUse"
  },
  "portableSetupNotes": [
    "To port to another repo:",
    "1. Copy .cursor/ folder, .memory/, and AGENTS.md.",
    "2. Fill AGENTS.md; run: python3 .cursor/context/memory-loader.py --sync",
    "3. Update protected-paths.json projectProtectedGlobs.",
    "4. Register domain skills in skills-manifest.v2.json.",
    "5. Use context-builder.py before every agent task."
  ]
}
