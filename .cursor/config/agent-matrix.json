{
  "schemaVersion": 1,
  "description": "Dynamic agent activation. Candidates are further filtered by active-layers.json (profile-sync). Do not list database-worker on pure UI rules.",
  "rules": [
    {
      "id": "code-loop-fix",
      "when": {
        "domains": [],
        "complexity": ["low", "medium"],
        "keywords": [
          "fix",
          "bug",
          "broken",
          "error",
          "regression",
          "patch",
          "typo",
          "code-loop",
          "hotfix"
        ]
      },
      "agents": ["frontend-worker", "backend-worker", "qa-worker"],
      "reviewer": null,
      "reviewMode": "optional",
      "maxSkills": 2,
      "notes": "Lightweight fix path. Layer filter drops workers whose layer is off. Prefer error-recovery."
    },
    {
      "id": "shape-lite",
      "when": {
        "domains": [],
        "complexity": ["low", "medium"],
        "keywords": [
          "shape-lite",
          "shape",
          "idea",
          "mvp",
          "should we",
          "quick scope",
          "brainstorm-lite"
        ]
      },
      "agents": ["architect-planner"],
      "reviewer": null,
      "reviewMode": "optional",
      "maxSkills": 2,
      "notes": "Compact shaping only. Output docs/plans/shape/*.md. Do not dispatch implement workers."
    },
    {
      "id": "design-specification",
      "when": {
        "domains": ["design", "frontend"],
        "complexity": ["medium", "high"],
        "keywords": [
          "design-specification",
          "design-contract",
          "design spec",
          "spec.md",
          "sketch",
          "wireframe",
          "visual pipeline"
        ]
      },
      "agents": ["designer-worker", "judge-agent"],
      "sequence": ["designer-worker", "judge-agent"],
      "reviewer": "judge-agent",
      "reviewMode": "required",
      "maxSkills": 3,
      "notes": "Only when frontend layer is on"
    },
    {
      "id": "react-button-fix",
      "when": {
        "domains": ["frontend"],
        "complexity": ["low", "medium"],
        "keywords": ["button", "form", "disabled", "click", "submit"]
      },
      "agents": ["frontend-worker"],
      "reviewer": null,
      "reviewMode": "optional",
      "maxSkills": 1
    },
    {
      "id": "frontend-ui",
      "when": {
        "domains": ["frontend"],
        "complexity": ["medium", "high"]
      },
      "agents": ["frontend-worker"],
      "reviewer": "judge-agent",
      "reviewMode": "optional",
      "maxSkills": 2
    },
    {
      "id": "frontend-with-design",
      "when": {
        "domains": ["frontend", "design"],
        "complexity": ["medium", "high"]
      },
      "agents": ["designer-worker", "frontend-worker"],
      "sequence": ["designer-worker", "frontend-worker"],
      "reviewer": "judge-agent",
      "reviewMode": "optional",
      "maxSkills": 2
    },
    {
      "id": "backend-module",
      "when": {
        "domains": ["backend"],
        "complexity": ["medium"]
      },
      "agents": ["backend-worker"],
      "reviewer": "judge-agent",
      "reviewMode": "optional",
      "maxSkills": 2
    },
    {
      "id": "auth-security",
      "when": {
        "domains": ["backend", "security"],
        "keywords": ["auth", "jwt", "login", "guard", "token", "rbac"]
      },
      "agents": ["architect-planner", "backend-worker", "security-worker"],
      "sequence": ["architect-planner", "backend-worker", "security-worker"],
      "reviewer": "judge-agent",
      "reviewMode": "required",
      "maxSkills": 3,
      "notes": "database-worker added only if database layer on (via active-layers filter + planner)"
    },
    {
      "id": "database-migration",
      "when": {
        "domains": ["database"],
        "keywords": ["migration", "schema", "index", "table"]
      },
      "agents": ["database-worker"],
      "reviewer": "judge-agent",
      "reviewMode": "required",
      "maxSkills": 2,
      "notes": "Inactive when database layer off"
    },
    {
      "id": "devops-infra",
      "when": {
        "domains": ["devops"]
      },
      "agents": ["devops-worker"],
      "reviewer": "judge-agent",
      "reviewMode": "optional",
      "maxSkills": 1
    },
    {
      "id": "qa-testing",
      "when": {
        "domains": ["qa"]
      },
      "agents": ["qa-worker"],
      "reviewer": null,
      "reviewMode": "optional",
      "maxSkills": 2
    },
    {
      "id": "plan-feature",
      "when": {
        "domains": [],
        "keywords": ["plan", "architect", "adr", "roadmap", "breakdown"]
      },
      "agents": ["architect-planner"],
      "reviewer": "judge-agent",
      "reviewMode": "optional",
      "maxSkills": 2
    },
    {
      "id": "protected-default",
      "when": {
        "protected": true
      },
      "agents": ["architect-planner"],
      "sequence": ["architect-planner"],
      "reviewer": "judge-agent",
      "reviewMode": "required",
      "maxSkills": 2
    }
  ]
}
