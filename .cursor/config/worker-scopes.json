{
  "schemaVersion": 1,
  "description": "Worker edit scopes. Portable globs work on single-package and monorepo. profile-sync does not delete agent entries; layer-off agents simply are not dispatched. Tighten globs to AGENTS.md §3 when porting if needed.",
  "genericRoles": {
    "planner": [
      "docs/**",
      ".cursor/**",
      "AGENTS.md",
      "README.md"
    ],
    "backend": [
      "**/api/**",
      "**/server/**",
      "**/backend/**",
      "**/services/**",
      "src/**",
      "lib/**",
      "packages/**"
    ],
    "frontend": [
      "app/**",
      "src/**",
      "pages/**",
      "components/**",
      "public/**",
      "**/web/**",
      "**/frontend/**",
      "**/ui/**",
      "packages/**"
    ],
    "designer": [
      "app/**",
      "src/**",
      "pages/**",
      "components/**",
      "**/web/**",
      "**/frontend/**",
      "**/ui/**",
      "**/design/**",
      "docs/design/**",
      "packages/**",
      "docs/**"
    ],
    "database": [
      "**/database/**",
      "**/migrations/**",
      "**/db/**",
      "**/prisma/**",
      "**/drizzle/**",
      "docs/adr/**"
    ],
    "ai": [
      "**/ai/**",
      "**/llm/**",
      "**/prompts/**",
      "packages/**"
    ],
    "devops": [
      "docker/**",
      "infra/**",
      ".github/workflows/**",
      "**/Dockerfile*",
      "**/*.yml",
      "**/*.yaml",
      ".env.example"
    ],
    "qa": [
      "**/*.spec.*",
      "**/*.test.*",
      "**/*.e2e.*",
      "tests/**",
      "docs/reviews/**"
    ],
    "security": [
      "**/auth/**",
      "**/security/**",
      "**/guards/**",
      ".cursor/rules/**",
      "docs/reviews/**"
    ],
    "judge": [
      "docs/reviews/**"
    ],
    "learning": [
      "docs/retrospective.md",
      "docs/memory/**",
      "docs/reviews/**",
      ".cursor/patterns/**",
      ".cursor/skills/**"
    ]
  },
  "default": [
    "**/*"
  ],
  "portingNote": "Fill AGENTS.md §0 then run profile-sync.py. Optional: tighten agent globs to exact §3 paths. Do NOT delete an agent entry (falls back to allow-all). Layer-off agents are filtered at dispatch, not by deleting scopes.",
  "agents": {
    "architect-planner": [
      "docs/**",
      ".cursor/**",
      "AGENTS.md",
      "README.md"
    ],
    "scaffold-agent": [
      "**/modules/**",
      "**/migrations/**",
      "**/app/**",
      "app/**",
      "src/**",
      "**/processors/**",
      "packages/**",
      "AGENTS.md",
      "docs/plans/**"
    ],
    "backend-worker": [
      "**/api/**",
      "**/server/**",
      "**/backend/**",
      "**/services/**",
      "src/**",
      "lib/**",
      "packages/**"
    ],
    "frontend-worker": [
      "app/**",
      "src/**",
      "pages/**",
      "components/**",
      "public/**",
      "**/web/**",
      "**/frontend/**",
      "**/ui/**",
      "packages/**"
    ],
    "designer-worker": [
      "app/**",
      "src/**",
      "pages/**",
      "components/**",
      "**/web/**",
      "**/frontend/**",
      "**/ui/**",
      "**/design/**",
      "packages/**",
      "docs/design/**",
      "docs/plans/**"
    ],
    "database-worker": [
      "**/database/**",
      "**/migrations/**",
      "**/db/**",
      "**/prisma/**",
      "**/drizzle/**",
      "docs/adr/**"
    ],
    "devops-worker": [
      "docker/**",
      "infra/**",
      ".github/workflows/**",
      "**/Dockerfile*",
      "**/*.yml",
      "**/*.yaml",
      ".env.example"
    ],
    "qa-worker": [
      "**/*.spec.*",
      "**/*.test.*",
      "**/*.e2e.*",
      "tests/**",
      "docs/reviews/**"
    ],
    "security-worker": [
      "**/auth/**",
      "**/security/**",
      "**/guards/**",
      ".cursor/rules/**",
      "docs/reviews/**"
    ],
    "judge-agent": [
      "docs/reviews/**"
    ],
    "spike-agent": [
      "docs/spikes/**"
    ],
    "contract-agent": [
      "docs/contracts/**",
      "packages/**",
      "src/**",
      "lib/**"
    ],
    "learning-agent": [
      "docs/retrospective.md",
      "docs/memory/**",
      "docs/reviews/**",
      ".cursor/patterns/**",
      ".cursor/skills/**"
    ]
  }
}
